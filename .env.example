# Copy to .env and adjust. Used by docker-compose and the backend.

# Deployment environment. When set to "production" the backend refuses to start
# with any of the insecure defaults below (see ACP_SECRET_KEY and
# ACP_FIRST_SUPERUSER_PASSWORD) and the demo seed refuses to run.
ACP_ENVIRONMENT=development

# REQUIRED in production: unique random string of >= 32 chars (`openssl rand -hex 32`)
ACP_SECRET_KEY=

# Optional: dedicated key to encrypt recoverable PINs at rest. A urlsafe-base64
# 32-byte Fernet key (python -c "from cryptography.fernet import Fernet;
# print(Fernet.generate_key().decode())"). If unset, a separate key is derived
# from ACP_SECRET_KEY. Rotating either key makes existing stored PINs unreadable.
# ACP_PIN_ENCRYPTION_KEY=

# Postgres password for docker-compose
POSTGRES_PASSWORD=change-me

# Hardware gateway: "simulated" (demo/dev) or "tcp" (real L04 boards on the network)
ACP_GATEWAY_MODE=simulated

# Comma-separated allowed origins for the browser app
ACP_CORS_ORIGINS=http://localhost:8080

# Auth cookies. Secure cookies are only sent by the browser over HTTPS, so the
# dev quick-start (plain HTTP) uses false. In production this MUST be true and
# the app must sit behind a TLS edge (the backend refuses to start otherwise).
ACP_COOKIE_SECURE=false
# SameSite policy: lax (default) | strict | none. Use none only with Secure=true
# and a cross-site frontend.
# ACP_COOKIE_SAMESITE=lax
# Optional cookie domain (e.g. .example.com) to share across subdomains.
# ACP_COOKIE_DOMAIN=

# Initial platform super admin (created on first start).
# REQUIRED in production: change the password from this default.
ACP_FIRST_SUPERUSER_EMAIL=admin@example.com
ACP_FIRST_SUPERUSER_PASSWORD=admin1234

# Backend-only overrides (without docker-compose):
# ACP_DATABASE_URL=sqlite:///./access_control.db
# ACP_ACCESS_TOKEN_EXPIRE_MINUTES=30
# ACP_REFRESH_TOKEN_EXPIRE_DAYS=7
